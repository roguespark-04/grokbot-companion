# Grok Bot Companion audio relay — never commit real secrets (.env is gitignored)
# Copy to .env and fill in. DEVICE_TOKEN / INTERNAL_TOKEN auto-generate on first run if blank.

PUBLIC_BASE_URL=http://100.x.x.x:8787
RELAY_BIND=0.0.0.0
RELAY_PORT=8787

# Meridian “Muse Charm wake” webhook (JSON-only). Leave blank for local/dev (wakes skipped).
MERIDIAN_WEBHOOK_URL=
MERIDIAN_SENDER_KEY=

# Device ↔ relay auth (v1). Prefer Bearer DEVICE_TOKEN; optional HMAC with DEVICE_HMAC_SECRET.
DEVICE_TOKEN=
DEVICE_HMAC_SECRET=

# Meridian/ops → relay reply write (PUT /internal/result/<job_id>)
INTERNAL_TOKEN=

# Persistence
DATA_DIR=/workspace/grokbot-companion-push/relay/data
JOB_TTL_MS=300000
MAX_UPLOAD_BYTES=5242880
