# Grok Bot Companion — ESP32-S3R8 (8MB octal PSRAM, 16MB flash)
# Target: Waveshare ESP32-S3-Touch-AMOLED-1.75 — ESP-IDF >= 5.5, BSP waveshare/esp32_s3_touch_amoled_1_75 ^3

CONFIG_IDF_TARGET="esp32s3"

# Flash / PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# USB Serial/JTAG console (native USB-C)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Power management: automatic light sleep while locked (power_mgr.c)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y

# Wi-Fi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# TLS / HTTP
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# Relay is public HTTPS via Tailscale Funnel (Let's Encrypt chain, in the bundle).
# TLS buffers in PSRAM to keep internal RAM for Wi-Fi + LVGL.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# LVGL 9 (fonts used by main/ui/ui_theme.h)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_ROLLER=y
CONFIG_LV_USE_SLIDER=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_BUTTONMATRIX=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_LABEL_LONG_TXT_HINT=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_DRAW_SW_COMPLEX=y
# 3-stop scrim gradient behind the home caption (ui_home.c)
CONFIG_LV_GRADIENT_MAX_STOPS=3

# Log
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
