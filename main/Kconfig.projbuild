menu "Grok Bot Companion Configuration"

    config MUSE_DEVICE_ID
        string "Device ID"
        default "pocket-001"
        help
            Unique identifier for upload + Meridian wake (via relay).
            Prefer a stable per-unit ID (e.g. derived from MAC) in production.

    config MUSE_WIFI_SSID
        string "Wi-Fi SSID"
        default "YOUR_SSID"
        help
            Placeholder — set via menuconfig before flash. Do not commit real credentials.

    config MUSE_WIFI_PASSWORD
        string "Wi-Fi password"
        default "YOUR_PASSWORD"
        help
            Placeholder — set via menuconfig before flash. Do not commit real credentials.

    config MUSE_UPLOAD_URL
        string "Audio relay base URL"
        default "https://relay.example.ts.net"
        help
            Tailscale (or LAN) relay base. Device POSTs /upload and polls /result/:job_id.
            Device talks ONLY to this relay — never holds Meridian sender key.

    config MUSE_DEVICE_RELAY_TOKEN
        string "Device↔relay bearer token (optional)"
        default ""
        help
            Bearer for device→relay auth (v1 alternative to HMAC). Empty in skeleton.

    config MUSE_HMAC_SECRET
        string "Device↔relay HMAC secret (optional)"
        default ""
        help
            If set, upload/poll requests include X-Signature over the body/path.
            This is NOT the Meridian webhook sender key.

    config MUSE_WEBHOOK_URL
        string "(Relay-only doc) Meridian wake URL — do not use on device in production"
        default "https://example.invalid/webhooks/muse-charm-wake"
        help
            Documented for relay/.env — ESP32 production builds must not call Meridian
            directly. Skeleton may leave this unused.

    config MUSE_SENDER_BEARER_TOKEN
        string "(Relay-only doc) Meridian sender key — NEVER flash in production"
        default ""
        help
            Belongs in relay environment only. Left in Kconfig as a warning placeholder.

    config MUSE_AUDIO_SAMPLE_RATE
        int "Capture sample rate for upload (Hz)"
        default 16000
        help
            Contract: 16 kHz mono PCM WAV. Board BSP voice profile is 24 kHz —
            downsample or reconfigure I2S as needed.

    config MUSE_PTT_HOLD_MS
        int "Minimum PTT hold before capture starts (ms)"
        default 50
        range 0 500

    config MUSE_WAKE_LONG_PRESS_MS
        int "Locked: BOOT hold threshold that starts a voice turn (ms)"
        default 300
        range 150 1000
        help
            While the screen is locked (asleep), a BOOT press shorter than this only wakes
            the screen (no recording). Holding past it wakes AND starts LISTENING; audio is
            captured from the moment of wake so the first words are kept.

    config MUSE_DIM_BEFORE_SLEEP_MS
        int "Dim duration before the screen turns off (ms)"
        default 4000
        range 0 30000
        help
            After the auto-sleep timeout the AMOLED dims and shows a brief "sleeping"
            hint for this long; any touch / BOOT press cancels.

    config MUSE_PREROLL_MS
        int "Mic pre-roll kept while armed (ms)"
        default 300
        range 0 1000
        help
            Ring buffer prepended to a turn started by VAD (always-listen) so the start
            of the first word isn't clipped.

    config MUSE_MAX_UTTERANCE_S
        int "Max utterance length (s)"
        default 20
        range 3 60

    config MUSE_MIN_UTTERANCE_MS
        int "Min utterance length to upload (ms)"
        default 300
        range 0 2000

    config MUSE_REPLY_TIMEOUT_S
        int "Give up waiting for a reply after (s)"
        default 120
        range 10 600

    config MUSE_CAPTURE_STUB_SILENCE
        bool "Stub mic returns silence (exercise relay path before ES7210 is wired)"
        default n

    config MUSE_TZ
        string "POSIX TZ string"
        default "CST6CDT,M3.2.0,M11.1.0"
        help
            Local time zone for the status bar / device panel (Frank: America/Chicago).

    config MUSE_SNTP_SERVER
        string "SNTP server"
        default "pool.ntp.org"

    config MUSE_PTT_USE_BOOT_BUTTON
        bool "Use BOOT button (GPIO0) as press-and-hold PTT"
        default y
        help
            Confirmed: BOOT GPIO0 (active low) is press-and-hold PTT
            (hold=capture, release=upload→relay). PWR is power on/off only
            (AXP2101 / board PMIC) — not used for PTT. Touch PTT deferred.

endmenu
