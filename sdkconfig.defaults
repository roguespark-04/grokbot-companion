# Muse Charm — sensible defaults for ESP32-S3R8 (8MB PSRAM, 16MB Flash)
# Target: Waveshare ESP32-S3-Touch-AMOLED-1.75

CONFIG_IDF_TARGET="esp32s3"

# Flash / PSRAM (matches board: external 16MB flash, octal 8MB PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# USB Serial/JTAG console (Type-C native USB on this board)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Wi-Fi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# HTTPS / TLS (webhook + audio upload)
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# HTTP client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Log
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Partition: use default single factory app for skeleton
# (enlarge when adding LVGL assets / OTA)
